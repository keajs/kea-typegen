{
    "compilerOptions": {
        "module": "Node16",
        "esModuleInterop": false,
        "skipLibCheck": true,
        "declaration": true,
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "target": "ES2019",
        "sourceMap": true,
        "outDir": "./dist",
        "baseUrl": "./src",
        "incremental": true,
        "types": ["jest", "node"],
        "resolveJsonModule": true
    },
    "exclude": [
        "node_modules",
        "dist",
        "samples",
        "samples-inline",
        "form-plugin"
    ]
}
